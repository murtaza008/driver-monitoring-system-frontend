# URL of the deployed backend (no trailing slash, no /api — that's added automatically).
# Leave unset for local dev — it falls back to http://<current-host>:5000/api.
VITE_API_URL=https://your-backend.vercel.app

# Firebase Web SDK config (Firebase Console → Project Settings → General → Your apps
# → Web app → Config). Not a traditional secret — see the comment in src/lib/firebase.js
# for why it's still pulled from env vars instead of hardcoded.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
